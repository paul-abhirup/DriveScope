# DriveScope Environment Configuration

# Execution Mode: "docker" or "minimal" (SQLite + in-process worker)
MODE=minimal

# Application
PROJECT_NAME="DriveScope"
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
SECRET_KEY=drivescope-dev-insecure-secret-key-change-in-prod

# Database (PostgreSQL for standard/docker mode, SQLite for minimal mode)
DATABASE_URL=sqlite:///./drivescope.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivescope

# Redis & Celery (used in Docker mode)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (local filesystem by default, MinIO/S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=drivescope-artifacts

# Model Defaults
DEFAULT_MODEL_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
